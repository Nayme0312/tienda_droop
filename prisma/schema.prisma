// Esquema de la base de datos de STREETVIBE.
//
// AISLAMIENTO: todas las migraciones actuan exclusivamente sobre la base de
// datos que indique DATABASE_URL (streetvibe_shop). La shadow database usada
// por `prisma migrate dev` se declara de forma explicita en SHADOW_DATABASE_URL
// (streetvibe_shop_shadow) para que Prisma no cree ni borre bases con nombres
// improvisados en un servidor PostgreSQL donde conviven otros proyectos.

generator client {
  provider = "prisma-client-js"
}

// En Prisma 7 las URLs de conexion ya no viven en el schema: se declaran en
// prisma.config.ts (para la CLI) y se pasan al cliente mediante el adaptador
// de driver en lib/db.ts.
datasource db {
  provider = "postgresql"
}

/// Administrador del panel. Nunca se almacena la contrasena, solo su hash.
model Admin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admins")
}

/// Categoria de productos. El `slug` es el identificador estable que usan
/// tanto las URLs de la tienda como la API (ver lib/api/product-dto.ts).
model Category {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  /// Seccion de tienda: si es false, ni la categoria ni sus productos se
  /// muestran en la tienda publica. El panel sigue gestionandolos con
  /// normalidad; solo cambia lo que ve el cliente.
  isVisible Boolean @default(true)
  /// Texto de presentacion de la seccion en la portada y en su pagina. Vacio
  /// = la tienda usa el texto por defecto de la seccion, si lo tiene.
  description String @default("")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("categories")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

model Product {
  id          String        @id @default(cuid())
  /// Codigo numerico que ve el administrador (1000, 1001...). Lo asigna la
  /// secuencia "products_code_seq" de PostgreSQL al crear el producto; nunca se
  /// escribe ni se edita a mano, y no se reutiliza al eliminar un producto.
  code        Int           @unique @default(autoincrement())
  name        String
  slug        String        @unique
  description String        @default("")
  /// Importe entero en la moneda de la tienda (COP, sin decimales).
  price       Int
  oldPrice    Int?
  stock       Int           @default(0)
  status      ProductStatus @default(ACTIVE)
  categoryId  String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Campos que la tienda publica ya mostraba y que solo vivian en el archivo
  // estatico lib/products.ts. Ahora estan aqui para que panel y tienda lean
  // exactamente la misma fuente.
  /// Tallas disponibles. Vacio en productos sin talla (gorras, pines).
  sizes   String[] @default([])
  colors  String[] @default([])
  /// Etiqueta destacada: "Nuevo", "Popular", "Exclusivo"...
  badge   String?
  /// Ficha tecnica: pares clave-valor que la tienda lista en el modal.
  details Json     @default("{}")
  /// Video del producto (ruta de /api/uploads). Opcional e independiente de
  /// las imagenes: un producto puede tener solo imagenes, solo video o ambos.
  videoUrl String?
  /// Tipo de gorra (Beisbolera, Cerrada...). Solo lo usan los productos de la
  /// seccion "gorras"; en el resto de categorias es siempre null.
  capTypeId String?
  /// Destacado en la portada (estrella del panel). La portada muestra solo los
  /// productos destacados de cada seccion; la pagina de cada seccion sigue
  /// listando todo su catalogo.
  isFeatured Boolean   @default(false)
  /// Cuando se marco la estrella. Ordena los destacados (el ultimo marcado
  /// primero); null si no esta destacado.
  featuredAt DateTime?

  // Restrict: no se permite borrar una categoria que aun tenga productos.
  category   Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  // Restrict: un tipo de gorra con productos asignados no se puede borrar.
  capType    CapType?           @relation(fields: [capTypeId], references: [id], onDelete: Restrict)
  images     ProductImage[]
  promotions PromotionProduct[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([status])
  @@index([capTypeId])
  @@index([isFeatured])
  @@map("products")
}

/// Tipo de gorra, administrable desde el panel (Gorras > Tipos de gorra). Es
/// el filtro principal de la seccion publica de gorras. Los tipos iniciales
/// (Beisbolera y Cerrada) los crea la migracion.
model CapType {
  id       String  @id @default(cuid())
  name     String
  /// Derivado del nombre: evita dos tipos con el mismo nombre escrito distinto
  /// ("Cerrada" / "cerrada") y es la clave del filtro en la tienda.
  slug     String  @unique
  /// Inactivo: desaparece del filtro de la tienda y no se puede asignar a
  /// productos nuevos, pero los productos que ya lo tienen lo conservan.
  isActive Boolean @default(true)
  /// Gorras de este tipo se venden por talla cerrada (7 1/4, 7 3/8...). Si hay
  /// algun tipo activo con esta marca, la tienda muestra la Guia de tallas y
  /// filtra por talla las gorras de estos tipos (Product.sizes).
  usesFittedSizes Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("cap_types")
}

enum PromotionScope {
  /// Se aplica a todo el catalogo.
  ALL
  /// Se aplica solo a los productos de PromotionProduct.
  SELECTED
}

/// Promocion por porcentaje.
///
/// IMPORTANTE: una promocion NUNCA modifica `Product.price`. El precio original
/// se conserva intacto y el precio promocional se calcula al leer, en
/// lib/api/promotion-pricing.ts.
model Promotion {
  id              String         @id @default(cuid())
  name            String
  /// Porcentaje entero de descuento (1-99).
  discountPercent Int
  scope           PromotionScope @default(ALL)
  startsAt        DateTime
  endsAt          DateTime
  /// Interruptor manual. Una promocion esta vigente solo si isActive = true
  /// Y ademas la fecha actual esta entre startsAt y endsAt.
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  products PromotionProduct[]

  @@index([isActive, startsAt, endsAt])
  @@map("promotions")
}

/// Tabla puente para las promociones de ambito SELECTED.
model PromotionProduct {
  promotionId String
  productId   String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId])
  @@map("promotion_products")
}

/// Estado del pago, tal como lo reporta Wompi. PENDING tambien cubre el pedido
/// recien creado cuyo cliente aun no ha pagado (o abandono el checkout).
enum PaymentStatus {
  PENDING
  APPROVED
  DECLINED
  /// Anulado / cancelado despues de creado.
  VOIDED
  ERROR
}

/// Gestion interna del pedido desde el panel, independiente del pago.
enum FulfillmentStatus {
  NEW
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

/// Por donde entro la venta.
enum SaleChannel {
  /// Tienda en linea, pagada con Wompi.
  ONLINE
  /// Venta presencial registrada a mano desde el panel.
  IN_PERSON
}

/// Como se cobro. WOMPI es siempre una venta ONLINE; el resto, presenciales.
enum PaymentMethod {
  WOMPI
  CASH
  TRANSFER
  OTHER
}

/// Venta de la tienda: pedido en linea pagado (o en proceso de pago) con Wompi,
/// o venta presencial registrada desde el panel (`channel`).
///
/// En los pedidos en linea el importe se calcula SIEMPRE en el servidor
/// (lib/checkout/pricing.ts) al crear el pedido, y el pago solo se da por bueno
/// si Wompi confirma exactamente `amountInCents` para esta `reference`.
///
/// Las ventas presenciales nacen ya APPROVED (lib/sales/manual-sale.ts), con
/// `paidAt` igual a la fecha de la venta y los datos de entrega vacios.
model Order {
  id             String            @id @default(cuid())
  /// Referencia unica. En los pedidos en linea es la que se envia a Wompi.
  reference      String            @unique
  channel        SaleChannel       @default(ONLINE)
  paymentMethod  PaymentMethod     @default(WOMPI)
  paymentStatus  PaymentStatus     @default(PENDING)
  fulfillment    FulfillmentStatus @default(NEW)
  /// Clave que genera el formulario de venta presencial: si la misma venta se
  /// envia dos veces (doble clic, reintento de red) solo se registra una.
  idempotencyKey String?           @unique

  /// Total en pesos (COP, sin decimales) y el mismo valor en centavos, que es
  /// lo que se firma y se envia a Wompi.
  total         Int
  amountInCents Int
  currency      String @default("COP")

  customerName  String
  customerEmail String
  customerPhone String
  address       String
  city          String
  region        String
  notes         String?

  /// Datos de la transaccion en Wompi.
  wompiTransactionId String?   @unique
  paymentMethodType  String?
  statusMessage      String?
  paidAt             DateTime?

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     OrderItem[]

  @@index([paymentStatus, createdAt])
  @@index([paymentStatus, paidAt])
  @@map("orders")
}

/// Linea de pedido. Guarda una copia del nombre y del precio cobrado: si el
/// producto cambia o se borra despues, el pedido sigue siendo fiel.
model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String?
  productName String
  unitPrice   Int
  quantity    Int
  size        String?
  color       String?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  isPrimary Boolean  @default(false)
  /// Mantiene el orden en que el panel muestra las imagenes adicionales.
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  // Cascade: al borrar un producto desaparecen sus filas de imagen. En la
  // etapa 3, antes de este borrado habra que eliminar los ficheros del
  // almacenamiento real.
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

/// Fecha especial (temporada) que cambia el aspecto de la tienda publica:
/// Navidad, y en el futuro Halloween, San Valentin, Black Friday...
///
/// `slug` identifica el tema visual que aplica la tienda (ver
/// lib/seasons/registry.ts). Como mucho una puede estar activa a la vez: al
/// activar una, la API desactiva las demas en la misma transaccion.
model SpecialDate {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("special_dates")
}

/// Cinta marquesina de la portada. Es una configuracion unica: la tabla tiene
/// una sola fila con id "main" (la crea la migracion y la API la mantiene con
/// upsert). El texto se divide por "·" en frases separadas visualmente.
model StoreMarquee {
  id          String   @id @default("main")
  /// Mensaje que muestra la tienda.
  text        String
  /// Plantilla que el panel carga con "Usar mensaje predeterminado". La API
  /// nunca la sobrescribe al guardar, asi que sigue disponible aunque el
  /// mensaje activo se cambie por uno personalizado.
  defaultText String   @default("CALIDAD PREMIUM · ENVÍOS RÁPIDOS · COMPRA SEGURA · TUS DATOS PROTEGIDOS · GARANTÍA · SATISFACCIÓN ASEGURADA")
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@map("store_marquee")
}

enum HeroMediaType {
  VIDEO
  IMAGE
}

/// Hero de la portada, administrable desde el panel. Configuracion unica: una
/// sola fila con id "main" (la crea la migracion y la API la mantiene con
/// upsert). Video e imagen se guardan por separado para poder alternar entre
/// ellos sin volver a subir nada; `mediaType` decide cual se muestra.
model HeroSettings {
  id        String        @id @default("main")
  mediaType HeroMediaType @default(VIDEO)
  videoUrl  String?
  imageUrl  String?
  isActive  Boolean       @default(true)
  updatedAt DateTime      @updatedAt

  @@map("hero_settings")
}

/// Testimonio de cliente que muestra la portada ("Lo Que Dicen"). Se gestiona
/// a mano desde el panel: crear, editar, eliminar y activar/desactivar. Solo
/// los activos llegan a la tienda, ordenados del mas reciente al mas antiguo.
model Testimonial {
  id           String   @id @default(cuid())
  customerName String
  /// Foto del cliente (ruta de /api/uploads). Sin ella, la tienda muestra sus iniciales.
  avatarUrl    String?
  /// De 1 a 5 (lo garantiza la API y un CHECK en la base de datos).
  rating       Int
  comment      String
  /// Producto que compro, opcional ("Camisa Chaos").
  productName  String?
  /// Insignia de "Compra verificada".
  isVerified   Boolean  @default(true)
  isActive     Boolean  @default(true)
  /// Fecha de la resena: de ella sale el "hace 1 mes" de la tienda.
  reviewedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, reviewedAt])
  @@map("testimonials")
}

/// Suscriptor del boletin (formulario "Unete al Movimiento" del pie de pagina).
/// El email se guarda en minusculas y es unico: suscribirse dos veces no crea
/// otra fila ni reenvia la bienvenida. `welcomeSentAt` queda en null si el
/// email de bienvenida no se pudo enviar (Resend caido o sin configurar).
model NewsletterSubscriber {
  id            String    @id @default(cuid())
  email         String    @unique
  createdAt     DateTime  @default(now())
  welcomeSentAt DateTime?

  @@map("newsletter_subscribers")
}
