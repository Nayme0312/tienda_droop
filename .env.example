# Plantilla de variables de entorno. Copiar a .env y rellenar.
# Este archivo SI se sube a git: no debe contener ningun valor real.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Base de datos exclusiva de esta tienda. No apuntar nunca a la base "postgres"
# ni a la base de otro proyecto: las migraciones actuan sobre lo que diga esta
# variable.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/streetvibe_shop?schema=public"

# Base auxiliar que usa "prisma migrate dev" para validar migraciones antes de
# aplicarlas. Se declara de forma explicita para que Prisma no cree ni borre
# bases con nombres improvisados en un servidor compartido con otros proyectos.
SHADOW_DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/streetvibe_shop_shadow?schema=public"

# ---------------------------------------------------------------------------
# Sesion del panel administrativo
# ---------------------------------------------------------------------------
# Clave con la que se firma el JWT de sesion. Minimo 32 caracteres.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Si cambia, todas las sesiones abiertas caducan.
AUTH_SECRET="cadena-aleatoria-de-al-menos-32-caracteres"

# ---------------------------------------------------------------------------
# Administrador inicial (solo lo usa el seed / scripts/create-admin.mjs)
# ---------------------------------------------------------------------------
ADMIN_EMAIL="admin@ejemplo.com"
ADMIN_NAME="Administrador"

# Opcional. Si se deja sin definir, el seed genera una contrasena aleatoria y
# la muestra UNA sola vez por consola. Solo se almacena su hash.
# ADMIN_PASSWORD=""

# ---------------------------------------------------------------------------
# Wompi (pagos en linea)
# ---------------------------------------------------------------------------
# Llaves en: comercios.wompi.co > Desarrolladores. NUNCA subir valores reales.
# Ninguna lleva NEXT_PUBLIC_: se usan solo en el servidor.
#
# Pruebas:     WOMPI_ENV="sandbox"    y llaves pub_test_ / test_integrity_ / test_events_
# Produccion:  WOMPI_ENV="production" y llaves pub_prod_ / prod_integrity_ / prod_events_
# El servidor se niega a cobrar si las llaves no corresponden al ambiente.
WOMPI_ENV="sandbox"
WOMPI_PUBLIC_KEY="pub_test_..."
WOMPI_INTEGRITY_SECRET="test_integrity_..."
WOMPI_EVENTS_SECRET="test_events_..."

# URL publica de la tienda, sin barra final. Wompi devuelve al cliente a
# <SITE_URL>/checkout/resultado. Si no se define, se usa el host de la peticion.
# SITE_URL="https://tu-dominio.com"

# URL de eventos a registrar en el dashboard de Wompi:
#   <SITE_URL>/api/webhooks/wompi

# ---------------------------------------------------------------------------
# Resend (email de bienvenida del boletin)
# ---------------------------------------------------------------------------
# Llave en: resend.com > API Keys. Se usa solo en el servidor (sin NEXT_PUBLIC_).
# Si esta vacia, el correo se guarda igual pero no se envia la bienvenida.
RESEND_API_KEY="re_..."

# Remitente. "onboarding@resend.dev" sirve para probar, pero Resend solo deja
# enviar desde el al correo de tu propia cuenta. Para enviar a cualquiera hay
# que verificar un dominio en Resend y usar una direccion de ese dominio.
RESEND_FROM="STREETVIBE <onboarding@resend.dev>"

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (anti-bots del formulario del boletin)
# ---------------------------------------------------------------------------
# Claves en: dash.cloudflare.com > Turnstile > Add widget (modo "Invisible" o
# "Managed"), con localhost y tu dominio en la lista de hostnames.
# Para desarrollo se pueden usar las claves de prueba de Cloudflare, que
# siempre aprueban: sitio 1x00000000000000000000AA y
# secreta 1x0000000000000000000000000000000AA.
# Sin TURNSTILE_SECRET_KEY el endpoint rechaza todas las suscripciones.
# La clave de sitio es publica (NEXT_PUBLIC_); la secreta, nunca.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x..."
TURNSTILE_SECRET_KEY="0x..."

# ---------------------------------------------------------------------------
# API (opcional)
# ---------------------------------------------------------------------------
# El panel y la API comparten el mismo origen, asi que por defecto el cliente
# usa rutas relativas ("/api") y no hace falta definir nada. Solo definir esta
# variable si algun dia la API se sirve desde otro dominio.
# NEXT_PUBLIC_API_URL="https://api.ejemplo.com"
